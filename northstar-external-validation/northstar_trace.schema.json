{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.local/northstar_trace.schema.json",
  "title": "NORTHSTAR External Blind Trace",
  "type": "object",
  "required": ["schema_version", "provenance", "observed_symptom", "trace_events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_label", "failure_category", "known_resolution_withheld", "sanitized_by_submitter"],
      "properties": {
        "project_label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "failure_category": {
          "enum": ["citation", "retrieval", "reranking", "provenance", "grounded_generation", "agent_evidence", "other"]
        },
        "known_resolution_withheld": { "const": true },
        "sanitized_by_submitter": { "const": true }
      }
    },
    "observed_symptom": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "trace_events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "type": "object" }
    }
  }
}